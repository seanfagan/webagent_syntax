<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
    <key>name</key>
    <string>WebAgent Comments</string>
    <key>scope</key>
    <string>source.webagent</string>
    <key>settings</key>
    <dict>
        <key>increaseIndentPattern</key>
        <string>(?x)
            ^ \s* \b(define\ data|if|else|decide\ for|repeat|for)\b .* $
        </string>
        <key>decreaseIndentPattern</key>
        <string>(?x)
            ^ \s* \b(end-define|end-if|else|end-decide|end-repeat|end-for)\b .* $
        </string>
        <key>shellVariables</key>
        <array>
            <dict>
                <key>name</key>
                <string>TM_COMMENT_START</string>
                <key>value</key>
                <string>/* </string>
            </dict>
        </array>
    </dict>
</dict>
</plist>
