%YAML 1.2
---
# See https://www.sublimetext.com/docs/syntax.html

name: webAgent Template
file_extensions:
  - wbt
scope: text.html.webagent
version: 2

extends: Packages/HTML/HTML.sublime-syntax

contexts:
  prototype:
    - meta_prepend: true
    - include: webagent-tags

  tag-attribute-value-content:
    - meta_prepend: true
    - include: webagent-tags

  strings-common-content:
    - meta_prepend: true
    - include: webagent-tags

  webagent-tags:
    - match: \@\@
      scope: constant.character.escape.webagent

    - match: \@
      scope: constant.character.escape.webagent punctuation.section.interpolation.begin.webagent
      push:
        - meta_scope: source.webagent.embedded
        - match: \^
          scope: constant.character.escape.webagent
        - match: \|
          scope: constant.character.escape.webagent punctuation.section.interpolation.end.webagent
          pop: true

    - match: <%
      embed: scope:source.webagent
      escape: (?=%>)
